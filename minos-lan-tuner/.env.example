# Coordinator
DATABASE_URL=sqlite:///./tuner.sqlite3
COORDINATOR_ADMIN_TOKEN=change-me
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=8080
LEASE_GRACE_SECONDS=120
MINOS_REPO_ROOT=
# Browser login. Generate with: DASHBOARD_ADMIN_PASSWORD='…' minosctl auth hash-password
# Then unset DASHBOARD_ADMIN_PASSWORD. Do not put the plaintext password in this file.
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=0

# Worker (separate machine or separate shell)
COORDINATOR_URL=http://127.0.0.1:8080
WORKER_TOKEN=
WORKER_ID=worker-a
CACHE_DIR=./cache
WORK_DIR=./work
MAX_CONCURRENT_JOBS=1
EXECUTION_MODE=mock
SCORING_VERSION=v1
LOG_LEVEL=INFO
